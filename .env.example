# Modèle des variables d'environnement. Copier en .env.local (non versionné) puis renseigner.
# Ne jamais mettre de vraie valeur dans ce fichier : il est versionné.

# Base locale SQLite (facultatif) : chemin du fichier. Par défaut : ./data/pipeline.db
PIPELINE_DB_PATH=

# Turso (base managée libSQL). Si TURSO_DATABASE_URL est renseignée, l'app utilise Turso au lieu de SQLite local.
# URL de la base, ex. libsql://<base>-<organisation>.turso.io (chiffrée : libsql, https ou wss ; http/ws seulement en local)
TURSO_DATABASE_URL=
# Jeton d'accès limité à la base (`turso db tokens create <base>`) ; obligatoire sauf avec `turso dev` en local
TURSO_AUTH_TOKEN=
